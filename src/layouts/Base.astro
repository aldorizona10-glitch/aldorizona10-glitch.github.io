---
// Self-hosted via @fontsource, bundled at build time. No runtime CDN request.
// "standard" carries both the weight and the width axis; the width axis is
// what the headlines lean on.
import '@fontsource-variable/archivo/standard.css';
import '@fontsource-variable/archivo/standard-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { profile } from '../data/site';
import { t } from '../i18n/content';
import { homeFor, LOCALES, DEFAULT_LOCALE, type Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);

const origin = (Astro.site ?? new URL(profile.siteUrl)).origin;
const canonical = new URL(homeFor(lang), origin).href;
// Absolute: link previews reject relative image paths.
const ogImage = new URL('/og.jpg', origin).href;
---

<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.meta.title}</title>
    <meta name="description" content={c.meta.description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#ECEDE8" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {LOCALES.map((code) => <link rel="alternate" hreflang={code} href={new URL(homeFor(code), origin).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(homeFor(DEFAULT_LOCALE), origin).href} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={c.meta.title} />
    <meta property="og:description" content={c.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={c.ogLocale} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={c.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={c.meta.title} />
    <meta name="twitter:description" content={c.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // Mark JS early so pre-animation states never hide content for no-JS visitors.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{c.a11y.skip}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap foot__inner">
        <p>{profile.name}, Padang, {new Date().getFullYear()}</p>
        <p>{c.footer}</p>
      </div>
    </footer>
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
