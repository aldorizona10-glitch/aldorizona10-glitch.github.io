---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { press, pressQuote } from '../data/site';

const title = 'About — Aldo Rizona';
const description =
  'A final-year Constitutional Law student at UIN Imam Bonjol Padang, writing his thesis, who reads software the way he reads statutes. Covered across Indonesian tech media after a $2,500 bounty on X/xAI.';
---

<Base title={title} description={description}>
  <PageHeader
    eyebrow="Pasal IV — About"
    title="A law student who <em>breaks things</em> on purpose"
  />

  <div class="shell article">
    <div class="rail">
      <div class="rail__inner">
        <span class="rail__mark">Reasoning</span>
        <span class="rail__label">Why the two<br />fit together</span>
      </div>
    </div>
    <div class="body">
      <p class="lead rise">
        I am a final-year Constitutional Law student at UIN Imam Bonjol Padang, currently writing my
        thesis. I also find vulnerabilities in software, and get paid for it.
      </p>
      <p class="rise">
        People treat that as a contradiction. It has never felt like one. Four years of legal training
        taught me a single stubborn habit: read a rule not to learn what it forbids, but to find what
        it forgot to mention. The article that omits a condition. The definition drawn too narrowly.
        The procedure that never says who verifies. Writing a thesis sharpens it further — you spend
        months defending every claim against someone whose job is to find the hole in it.
      </p>
      <p class="rise">
        Software turns out to read exactly the same way. An API is a set of rules about who may reach
        what. <strong>I don't find bugs because I am a stronger programmer than the people who wrote the
        code. I find them because I was trained to notice the missing sentence.</strong>
      </p>
      <p class="rise">
        Everything on this site is self-taught, built out of Padang, and verifiable by someone other
        than me — a paid report, a published advisory, code that maintainers agreed to keep.
      </p>
    </div>
  </div>

  <div class="shell article press">
    <div class="rail">
      <div class="rail__inner">
        <span class="rail__mark">Press</span>
        <span class="rail__label">In the<br />record</span>
      </div>
    </div>
    <div class="body">
      <h2 class="h-section rise">Told by <em>others</em></h2>

      <figure class="quote rise">
        <blockquote>“{pressQuote.text}”</blockquote>
        <figcaption>— {pressQuote.source}</figcaption>
      </figure>

      <ul class="press__list">
        {
          press.map((p) => (
            <li class="press__item rise">
              <span class="press__outlet">{p.outlet}</span>
              <span class="press__detail">{p.detail}</span>
              {p.url && (
                <a class="press__link" href={p.url} rel="noopener" target="_blank">
                  Read →
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <p class="press__note rise">
        Searching my name on Google returns an AI overview and the coverage above. The vulnerability
        class (IDOR) is public through that press — the reproduction is not.
      </p>
    </div>
  </div>
</Base>

<style>
  .quote {
    margin: 6px 0 34px;
    border-left: 1px solid var(--gold);
    padding-left: 24px;
    max-width: var(--measure);
  }
  .quote blockquote {
    font-family: var(--display);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--bone);
  }
  .quote figcaption {
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bone-faint);
  }
  .press__list {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
    border-top: 1px solid var(--hair-soft);
  }
  .press__item {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    gap: 20px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--hair-soft);
  }
  .press__outlet {
    font-family: var(--display);
    font-size: 1.05rem;
    color: var(--bone);
  }
  .press__detail {
    color: var(--bone-dim);
    font-size: 0.92rem;
  }
  .press__link {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--gold-lit);
    white-space: nowrap;
  }
  .press__note {
    margin-top: 22px;
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--bone-faint);
    max-width: var(--measure);
  }
  @media (max-width: 620px) {
    .press__item {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .press__link {
      justify-self: start;
    }
  }
</style>
