---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PRTable from '../components/PRTable.astro';
import { profile } from '../data/site';

const title = 'Open source — Aldo Rizona';
const description =
  'Seven pull requests merged into repositories I do not own, including three into WordPress/presence-api and one into the TestSprite CLI. Every row reviewed by a maintainer with no reason to be generous.';
---

<Base title={title} description={description}>
  <PageHeader
    eyebrow="Pasal II — Open source"
    title="Code other people <em>agreed to keep</em>"
    intro="Finding a flaw and fixing one are different skills, and only one of them is reviewed by strangers. Every change below was read by a maintainer who had no reason to be generous."
  />

  <div class="shell article">
    <div class="rail">
      <div class="rail__inner">
        <span class="rail__mark">Record</span>
        <span class="rail__label">Merged<br />pull requests</span>
      </div>
    </div>
    <div class="body">
      <PRTable />
      <p class="rise">
        Seven pull requests have been merged into repositories I do not own; the three in WordPress
        earned the <a href={profile.wordpress} rel="noopener" target="_blank">Plugin Developer badge</a>
        on WordPress.org. The parser fix in <code>arrow</code> is still open — under-maintained projects
        move slowly, and I would rather show the open one than pretend it merged.
      </p>
      <p class="rise">
        <a class="ghlink" href={profile.github} rel="noopener" target="_blank"
          >All {' '}repositories on GitHub →</a
        >
      </p>
    </div>
  </div>
</Base>

<style>
  code {
    font-family: var(--mono);
    font-size: 0.85em;
    background: var(--ink-raise);
    padding: 1px 5px;
    border-radius: 2px;
    color: var(--bone);
  }
  .ghlink {
    font-family: var(--mono);
    font-size: 0.86rem;
  }
</style>
