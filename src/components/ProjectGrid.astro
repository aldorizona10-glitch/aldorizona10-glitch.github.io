---
import { projects } from '../data/site';
import { t } from '../i18n/content';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);

// Column count is chosen so the last row is always full. Four items in a
// three-column grid would leave two dead cells.
const n = projects.length;
const cols = n <= 1 ? 1 : n === 3 || n === 5 || n === 6 ? 3 : 2;
---

<div class="works rise" style={`--cols:${cols}`}>
  {
    projects.map((p, i) => (
      <article class:list={['work', { 'work--shot': p.shot }]}>
        {
          p.shot && (
            <a class="work__shot" href={p.demo ?? p.repo} rel="noopener" target="_blank" tabindex="-1" aria-hidden="true">
              <picture>
                <source srcset={`${p.shot.src}.webp`} type="image/webp" />
                <img src={`${p.shot.src}.jpg`} alt={p.shot.alt} width="800" height="500" loading="lazy" decoding="async" />
              </picture>
            </a>
          )
        }
        <span class="work__idx">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="work__name">{p.name}</h3>
        <p class="work__blurb">{c.projects.blurbs[p.id]}</p>
        <span class="work__tags">{p.tags.join(' / ')}</span>
        <span class="work__links">
          <a class="work__link" href={p.repo} rel="noopener" target="_blank">
            {c.projects.repoLabel}
          </a>
          {p.demo && (
            <a class="work__link work__link--demo" href={p.demo} rel="noopener" target="_blank">
              {c.projects.demoLabel}
            </a>
          )}
        </span>
      </article>
    ))
  }
</div>

<style>
  /* Cell count follows item count, so the grid never shows an empty tile. */
  .works {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), 1fr);
    gap: 1px;
    background: var(--hair-soft);
    border: 1px solid var(--hair-soft);
  }
  .work {
    background: var(--ink);
    padding: 30px 28px 26px;
    display: flex;
    flex-direction: column;
    gap: 11px;
    transition: background-color 260ms var(--ease-out);
  }
  .work--shot {
    padding-top: 0;
  }
  /* Real product screenshots, not mock UI drawn from divs. */
  .work__shot {
    display: block;
    margin: 0 -28px 18px;
    border-bottom: 1px solid var(--hair-soft);
    overflow: hidden;
    background: var(--ink-deep);
  }
  .work__shot img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    display: block;
    /* The shots are bright next to an ink page; settle them down until hover. */
    opacity: 0.72;
    filter: saturate(0.85);
    transition:
      opacity var(--dur-hover) ease,
      filter var(--dur-hover) ease,
      transform 420ms var(--ease-out);
  }
  .work__idx {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--gold);
    opacity: 0.8;
  }
  .work__name {
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--step-2);
    line-height: 1.2;
    color: var(--bone);
  }
  .work__blurb {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.62;
    color: var(--bone-dim);
    max-width: 46ch;
  }
  .work__tags {
    margin-top: auto;
    padding-top: 16px;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone-faint);
  }
  .work__links {
    display: flex;
    gap: 10px;
    padding-top: 14px;
  }
  .work__link {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bone-dim);
    border: 1px solid var(--hair);
    padding: 6px 12px;
    transition:
      color var(--dur-hover) ease,
      border-color var(--dur-hover) ease,
      transform var(--dur-press) var(--ease-out);
  }
  .work__link--demo {
    color: var(--gold-lit);
    border-color: color-mix(in srgb, var(--gold) 45%, transparent);
  }
  .work__link:active {
    transform: scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    .work:hover {
      background-color: var(--ink-raise);
    }
    .work:hover .work__shot img {
      opacity: 1;
      filter: saturate(1);
      transform: scale(1.02);
    }
    .work__link:hover {
      color: var(--bone);
      border-color: var(--gold);
    }
  }
  @media (max-width: 760px) {
    .works {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .work,
    .work__link,
    .work__shot img {
      transition: none;
    }
    .work__link:active,
    .work:hover .work__shot img {
      transform: none;
    }
  }
</style>
