---
import { profile } from '../data/site';
import { t } from '../i18n/content';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);

const links = [
  { label: c.footer.labels.email, value: profile.email, href: `mailto:${profile.email}` },
  { label: 'GitHub', value: 'github.com/' + profile.githubHandle, href: profile.github },
  { label: 'HackerOne', value: 'hackerone.com/xauud', href: profile.hackerone },
  { label: 'huntr', value: 'huntr.com/users/' + profile.githubHandle, href: profile.huntr },
  { label: 'WordPress.org', value: 'profiles.wordpress.org/aldorza', href: profile.wordpress },
];
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="shell foot__inner">
    <div class="foot__lead">
      <p class="eyebrow">{c.footer.mark}</p>
      <h2 class="foot__title" set:html={c.footer.title} />
      <p class="foot__blurb">{c.footer.blurb}</p>
    </div>

    <nav class="foot__links" aria-label={c.a11y.contactNav}>
      {
        links.map((l) => (
          <a
            class="foot__link"
            href={l.href}
            rel="noopener"
            target={l.href.startsWith('mailto') ? undefined : '_blank'}
          >
            <span class="foot__value">{l.value}</span>
            <span class="foot__label">{l.label}</span>
          </a>
        ))
      }
    </nav>

    <p class="foot__sig">
      {profile.name}, {c.hero.location}<br />
      {c.footer.colophon[0]}<br />
      {c.footer.colophon[1]} &copy; {year}
    </p>
  </div>
</footer>

<style>
  .foot {
    background: var(--ink-deep);
    border-top: 1px solid var(--hair);
    padding-block: clamp(4rem, 2.5rem + 5vw, 6rem);
  }
  .foot__inner {
    display: grid;
    gap: 40px;
  }
  .foot__lead .eyebrow {
    margin-bottom: 18px;
  }
  .foot__title {
    font-size: var(--step-3);
    line-height: 1.1;
  }
  .foot__title :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .foot__blurb {
    margin-top: 18px;
    max-width: var(--measure);
    color: var(--bone-dim);
  }
  .foot__links {
    display: grid;
    max-width: var(--measure);
  }
  .foot__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    padding-block: 16px;
    border-bottom: 1px solid var(--hair-soft);
    font-family: var(--mono);
    font-size: 0.86rem;
    color: var(--bone);
    /* transform, not padding: padding would relayout on every hover frame. */
    transition:
      color var(--dur-hover) ease,
      transform var(--dur-hover) var(--ease-out);
  }
  .foot__value {
    display: inline-block;
  }
  .foot__label {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bone-faint);
    flex-shrink: 0;
  }
  .foot__sig {
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 2;
    color: var(--bone-faint);
    border-top: 1px solid var(--hair-soft);
    padding-top: 20px;
    max-width: var(--measure);
  }

  @media (hover: hover) and (pointer: fine) {
    .foot__link:hover {
      color: var(--gold-lit);
      transform: translateX(8px);
    }
  }
  .foot__link:active {
    transform: scale(0.99);
  }

  @media (prefers-reduced-motion: reduce) {
    .foot__link {
      transition: color var(--dur-hover) ease;
    }
    .foot__link:hover,
    .foot__link:active {
      transform: none;
    }
  }
</style>
