---
import PageHeader from '../PageHeader.astro';
import { press } from '../../data/site';
import { t } from '../../i18n/content';
import type { Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);
---

<PageHeader mark={c.about.mark} railLabel={c.about.railLabel} title={c.about.title} />

<section class="shell article">
  <div class="rail">
    <div class="rail__inner">
      <span class="rail__mark">{c.about.reasonMark}</span>
      <span class="rail__label" set:html={c.about.reasonRail} />
    </div>
  </div>
  <div class="body">
    <p class="lead rise">{c.about.lead}</p>
    {c.about.body.map((p) => <p class="rise" set:html={p} />)}
  </div>
</section>

<section class="shell article craft">
  <div class="rail">
    <div class="rail__inner">
      <span class="rail__mark">{c.about.craftMark}</span>
      <span class="rail__label" set:html={c.about.craftRail} />
    </div>
  </div>
  <div class="body">
    <h2 class="h-section rise" set:html={c.about.craftTitle} />
    <ul class="craft__grid">
      {
        c.about.craftAreas.map((a) => (
          <li class="craft__item rise">
            <span class="craft__name">
              <i class="craft__dot" aria-hidden="true" />
              {a.name}
            </span>
            <span class="craft__detail">{a.detail}</span>
          </li>
        ))
      }
    </ul>
    <p class="craft__note rise">{c.about.craftNote}</p>
  </div>
</section>

<section class="shell article press">
  <div class="rail" aria-hidden="true"></div>
  <div class="body">
    <h2 class="h-section rise" set:html={c.about.pressTitle} />

    <figure class="quote rise">
      <blockquote lang="id">&ldquo;{c.about.quote}&rdquo;</blockquote>
      <figcaption>{c.about.quoteSource}</figcaption>
    </figure>

    <ul class="press__list">
      {
        press.map((p) => (
          <li class="press__item rise">
            <span class="press__outlet">{p.outlet}</span>
            <span class="press__detail">{c.about.details[p.id]}</span>
            {p.url && (
              <a class="press__link" href={p.url} rel="noopener" target="_blank">
                {c.about.read}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <p class="press__note rise">{c.about.note}</p>
  </div>
</section>

<style>
  .article {
    border-bottom: none;
  }
  .body :global(p + p) {
    margin-top: 20px;
  }
  .body :global(p) {
    max-width: var(--measure);
    color: var(--bone-dim);
  }
  .body :global(strong) {
    color: var(--bone);
    font-weight: 500;
  }
  .press {
    padding-top: 0;
  }
  .quote {
    margin: 6px 0 34px;
    border-left: 1px solid var(--gold);
    padding-left: 24px;
    max-width: var(--measure);
  }
  .quote blockquote {
    font-family: var(--display);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--bone);
  }
  .quote figcaption {
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bone-faint);
  }
  .press__list {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
    border-top: 1px solid var(--hair-soft);
  }
  .press__item {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    gap: 20px;
    align-items: baseline;
    padding: 17px 0;
    border-bottom: 1px solid var(--hair-soft);
  }
  .press__outlet {
    font-family: var(--display);
    font-size: 1.05rem;
    color: var(--bone);
  }
  .press__detail {
    color: var(--bone-dim);
    font-size: 0.9rem;
  }
  .press__link {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-lit);
    white-space: nowrap;
  }
  .press__note {
    margin-top: 22px;
    font-family: var(--mono);
    font-size: 0.76rem;
    line-height: 1.75;
    color: var(--bone-faint);
    max-width: var(--measure);
  }

  /* — craft / disciplines — */
  .craft__grid {
    list-style: none;
    padding: 0;
    margin-top: 8px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* 1px gap over a hairline background draws the cell borders for free. */
    gap: 1px;
    background: var(--hair-faint);
    border: 1px solid var(--hair-faint);
    max-width: 820px;
  }
  .craft__item {
    display: grid;
    gap: 10px;
    padding: 22px 24px 26px;
    background: var(--ink);
    /* background + transform only, so the hover stays on the compositor. */
    transition:
      background-color var(--dur-hover) ease,
      transform var(--dur-hover) var(--ease-out);
  }
  .craft__name {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--display);
    font-size: var(--step-1);
    line-height: 1.1;
    color: var(--bone);
  }
  .craft__dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    background: var(--gold);
    /* ketupat: a rotated square, echoing the songket lattice. */
    transform: rotate(45deg);
    transition: transform var(--dur-hover) var(--ease-out);
  }
  .craft__detail {
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--bone-dim);
  }
  .craft__note {
    margin-top: 24px;
    font-family: var(--mono);
    font-size: 0.76rem;
    line-height: 1.8;
    color: var(--bone-faint);
    max-width: var(--measure);
    border-left: 1px solid var(--gold);
    padding-left: 18px;
  }

  @media (hover: hover) and (pointer: fine) {
    .craft__item:hover {
      background: var(--ink-raise);
      transform: translateY(-3px);
    }
    .craft__item:hover .craft__dot {
      transform: rotate(135deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .craft__item {
      transition: background-color var(--dur-hover) ease;
    }
    .craft__item:hover {
      transform: none;
    }
    .craft__dot {
      transition: none;
    }
  }

  @media (max-width: 620px) {
    .craft__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .press__item {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .press__link {
      justify-self: start;
    }
  }
</style>
