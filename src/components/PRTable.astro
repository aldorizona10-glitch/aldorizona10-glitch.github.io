---
import { pullRequests } from '../data/site';
import { t } from '../i18n/content';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);

// Group consecutive PRs by repo so the hairline marks a real boundary
// instead of underlining every single row.
type Group = { repo: string; rows: typeof pullRequests };
const groups: Group[] = [];
for (const pr of pullRequests) {
  const last = groups[groups.length - 1];
  if (last && last.repo === pr.repo) last.rows.push(pr);
  else groups.push({ repo: pr.repo, rows: [pr] });
}
---

<div class="tablewrap rise">
  <table>
    <caption>{c.oss.caption}</caption>
    <thead>
      <tr>
        <th scope="col">{c.oss.cols.project}</th>
        <th scope="col">{c.oss.cols.pr}</th>
        <th scope="col">{c.oss.cols.change}</th>
        <th scope="col">{c.oss.cols.state}</th>
      </tr>
    </thead>
    {
      groups.map((g) => (
        <tbody>
          {g.rows.map((pr, i) => (
            <tr>
              {i === 0 && (
                <th scope="rowgroup" class="repo" rowspan={g.rows.length}>
                  {g.repo}
                </th>
              )}
              <td class="pr">
                <a href={pr.url} rel="noopener" target="_blank">
                  {pr.number}
                </a>
              </td>
              <td class="change">{c.oss.changes[pr.number]}</td>
              <td class:list={['state', pr.merged ? 'merged' : 'open']}>
                {pr.merged ? c.oss.merged : c.oss.inReview}
              </td>
            </tr>
          ))}
        </tbody>
      ))
    }
  </table>
</div>

<style>
  .tablewrap {
    overflow-x: auto;
    max-width: var(--measure);
    margin-block: 6px 26px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 540px;
  }
  caption {
    text-align: left;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--bone-faint);
    padding-bottom: 12px;
  }
  thead th {
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--bone-faint);
    text-align: left;
    padding: 0 16px 10px 0;
    border-bottom: 1px solid var(--hair);
    white-space: nowrap;
  }
  /* Boundary between repo groups, not under every row. */
  tbody + tbody th,
  tbody + tbody td {
    border-top: 1px solid var(--hair-soft);
  }
  td,
  tbody th {
    padding: 13px 16px 13px 0;
    font-size: 0.9rem;
    color: var(--bone-dim);
    vertical-align: top;
    text-align: left;
  }
  tbody th.repo {
    color: var(--bone);
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 400;
    white-space: nowrap;
  }
  td.pr {
    font-family: var(--mono);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  td.state {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  td.state.merged {
    color: var(--sage);
  }
  td.state.open {
    color: var(--bone-faint);
  }
</style>
