---
import { pullRequests } from '../data/site';
---

<div class="tablewrap rise">
  <table>
    <caption>Contributions to repositories I do not own</caption>
    <thead>
      <tr>
        <th scope="col">Project</th>
        <th scope="col">PR</th>
        <th scope="col">Change</th>
        <th scope="col">State</th>
      </tr>
    </thead>
    <tbody>
      {
        pullRequests.map((pr) => (
          <tr>
            <td class="repo">{pr.repo}</td>
            <td class="pr">
              <a href={pr.url} rel="noopener" target="_blank">
                {pr.number}
              </a>
            </td>
            <td>{pr.change}</td>
            <td class:list={['state', pr.state === 'Merged' ? 'merged' : 'open']}>{pr.state}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .tablewrap {
    overflow-x: auto;
    max-width: var(--measure);
    margin-block: 6px 26px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 540px;
  }
  caption {
    text-align: left;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--bone-faint);
    padding-bottom: 12px;
  }
  th {
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--bone-faint);
    text-align: left;
    padding: 0 16px 10px 0;
    border-bottom: 1px solid var(--hair);
    white-space: nowrap;
  }
  td {
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--hair-soft);
    font-size: 0.92rem;
    color: var(--bone-dim);
    vertical-align: top;
  }
  td.repo {
    color: var(--bone);
    font-family: var(--mono);
    font-size: 0.82rem;
    white-space: nowrap;
  }
  td.pr {
    font-family: var(--mono);
    font-size: 0.82rem;
    white-space: nowrap;
  }
  td.state {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  td.state.merged {
    color: var(--sage);
  }
  td.state.open {
    color: var(--bone-faint);
  }
  tbody tr:last-child td {
    border-bottom: none;
  }
</style>
