---
import { profile } from '../data/site';
import { t } from '../i18n/content';
import { homeFor, LOCALES, LANG_LABEL, LANG_NAME, SECTIONS, type Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);
const menuLabel = lang === 'id' ? 'Menu' : 'Menu';
---

<header class="top" data-top>
  <div class="wrap top__inner">
    <a class="mark" href="#top" aria-label={c.a11y.home}>
      <span class="mark__hl" aria-hidden="true"></span>
      <span class="mark__name">Aldo Rizona</span>
    </a>

    <nav class="top__nav" aria-label={c.a11y.primary} id="site-nav">
      <ul>
        {
          SECTIONS.map((id) => (
            <li>
              <a href={`#${id}`} data-nav={id}>
                {c.nav[id]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="top__end">
      <ul class="lang" aria-label={c.a11y.lang}>
        {
          LOCALES.map((code) => (
            <li>
              <a
                href={homeFor(code)}
                hreflang={code}
                lang={code}
                aria-current={code === lang ? 'true' : undefined}
                title={LANG_NAME[code]}
              >
                {LANG_LABEL[code]}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--ink btn--sm" href={`mailto:${profile.email}`} data-magnetic>
        <span>{c.emailMe}</span>
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
        {menuLabel}
      </button>
    </div>
  </div>
</header>
