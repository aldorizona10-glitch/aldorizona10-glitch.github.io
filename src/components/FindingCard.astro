---
import { t } from '../i18n/content';
import type { Lang } from '../i18n/config';
import type { FindingId } from '../data/site';

interface Props {
  lang: Lang;
  id: FindingId;
  target: string;
  verifyUrl: string;
  sealed: boolean;
}
const { lang, id, target, verifyUrl, sealed } = Astro.props;
const c = t(lang);
const f = c.findings[id];
const L = c.security.specLabels;

const specs = [
  { k: L.severity, v: f.severity, hi: true },
  { k: L.class, v: f.cwe },
  { k: L.vector, v: f.vector },
  { k: L.platform, v: f.platform },
  { k: L.reported, v: f.reported },
  { k: L.resolution, v: f.resolution },
];
---

<article class="finding rise">
  <div class="finding__top">
    <span class="finding__target">{target}</span>
    <span class:list={['chip', sealed ? 'chip--gold' : 'chip--sage']}>{f.award}</span>
  </div>

  <p class="finding__summary">{f.summary}</p>

  <dl class="spec">
    {
      specs.map((s) => (
        <div>
          <dt>{s.k}</dt>
          <dd class:list={[{ hi: s.hi }]}>{s.v}</dd>
        </div>
      ))
    }
  </dl>

  <p class:list={['finding__detail', { sealed }]}>{f.detail}</p>

  <a class="finding__verify" href={verifyUrl} rel="noopener" target="_blank">
    <span>{f.verifyLabel}</span>
    <svg class="finding__arrow" viewBox="0 0 16 16" aria-hidden="true" width="13" height="13">
      <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
</article>

<style>
  .finding {
    position: relative;
    border: 1px solid var(--hair);
    background: linear-gradient(180deg, rgba(201, 162, 39, 0.045), transparent 60%);
    padding: clamp(1.5rem, 1rem + 2vw, 2.4rem);
  }
  .finding::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 34px;
    height: 34px;
    border-top: 2px solid var(--gold);
    border-left: 2px solid var(--gold);
  }
  .finding__top {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .finding__target {
    font-family: var(--display);
    font-size: var(--step-2);
    font-weight: 500;
    color: var(--bone);
  }
  .chip {
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    border: 1px solid var(--hair);
    padding: 5px 11px;
  }
  .chip--gold {
    color: var(--gold-lit);
    border-color: color-mix(in srgb, var(--gold) 50%, transparent);
  }
  .chip--sage {
    color: var(--sage);
    border-color: color-mix(in srgb, var(--sage) 45%, transparent);
  }
  .finding__summary {
    color: var(--bone-dim);
    max-width: 58ch;
    margin-bottom: 22px;
  }
  .spec {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 18px;
    border-top: 1px solid var(--hair);
    padding-top: 20px;
  }
  .spec dt {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--bone-faint);
    margin-bottom: 5px;
  }
  .spec dd {
    font-family: var(--mono);
    font-size: 0.84rem;
    color: var(--bone);
    line-height: 1.45;
  }
  .spec dd.hi {
    color: var(--gold-lit);
  }
  .finding__detail {
    margin-top: 24px;
    font-size: 0.95rem;
    color: var(--bone-dim);
    max-width: 62ch;
    line-height: 1.65;
  }
  .finding__detail.sealed {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--bone-faint);
    border-left: 2px solid var(--oxblood);
    padding-left: 16px;
  }
  .finding__verify {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--bone-dim);
    border-bottom: 1px solid var(--hair);
    padding-bottom: 3px;
    transition:
      color var(--dur-hover) ease,
      border-color var(--dur-hover) ease;
  }
  .finding__arrow {
    transition: transform var(--dur-hover) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .finding__verify:hover {
      color: var(--gold-lit);
      border-color: var(--gold);
    }
    .finding__verify:hover .finding__arrow {
      transform: translateX(3px);
    }
  }
  .finding__verify:active {
    transform: scale(0.985);
  }

  @media (prefers-reduced-motion: reduce) {
    .finding__arrow,
    .finding__verify {
      transition: color var(--dur-hover) ease;
    }
    .finding__verify:hover .finding__arrow,
    .finding__verify:active {
      transform: none;
    }
  }
</style>
